# ========================================
# CODA2Z - Configuration Environment
# ========================================

# Application
APP_NAME="Coda2z"
APP_VERSION="1.0.0"
ENVIRONMENT="development"  # development | production
DEBUG=true

# Server
HOST="0.0.0.0"
PORT=8501
API_PORT=8000

# Supabase Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# LLM Configuration
LLM_MODEL_NAME="qwen2.5:14b"
LLM_BASE_URL="http://localhost:11434"  # Ollama default
LLM_API_KEY=""  # Leave empty for local models
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_CONTEXT_WINDOW=4096

# Embeddings Configuration
EMBEDDINGS_MODEL_NAME="snowflake-arctic-embed2"
EMBEDDINGS_BASE_URL="http://localhost:11434"
EMBEDDINGS_DIMENSION=768

# Vector Store Configuration
VECTOR_STORE_TYPE="chromadb"
VECTOR_STORE_PATH="./vector_stores"
VECTOR_STORE_PERSIST=true

# ChromaDB Settings
CHROMA_HOST="localhost"
CHROMA_PORT=8000
CHROMA_TENANT="default_tenant"
CHROMA_DATABASE="default_database"

# RAG Configuration
RAG_TOP_K=5  # Number of documents to retrieve
RAG_SIMILARITY_THRESHOLD=0.7
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_ENABLE_RERANKING=false

# Security
SECRET_KEY="your-secret-key-change-this-in-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_MINUTES=10080  # 7 days
PASSWORD_MIN_LENGTH=8

# File Upload
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=".pdf,.docx,.txt,.md,.xlsx,.csv,.json,.pptx"
UPLOAD_DIR="./data/user_uploads"

# Logging
LOG_LEVEL="INFO"  # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FILE_PATH="./logs/coda2z.log"
LOG_ROTATION="100 MB"
LOG_RETENTION="30 days"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_HOUR=100

# GDPR Compliance
DATA_RETENTION_DAYS=90
AUTO_DELETE_OLD_CONVERSATIONS=true

# Monitoring
ENABLE_USAGE_TRACKING=true
ENABLE_ERROR_REPORTING=false
SENTRY_DSN=""  # Optional for production

# Azure Configuration (if applicable)
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER=""

# Redis (optional, for caching)
REDIS_URL=""
REDIS_CACHE_TTL=3600
